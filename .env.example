# Скопируйте в .env и поменяйте значения. Файл .env не коммитится.

# Пароль базы для docker compose
POSTGRES_PASSWORD=поменяйте-меня

# Подключение к базе, если запускаете CLI без докера
DATABASE_URL=postgresql://olymp:поменяйте-меня@localhost:5432/olymp

# Как представляемся сайтам при обходе (укажите свой контакт)
USER_AGENT=OlympNavigatorBot/0.1 (+mailto:you@example.com)

# Пауза между запросами к одному сайту, секунды
REQUEST_DELAY=3

# Токен Telegram-бота от @BotFather (понадобится на этапе 2)
# TELEGRAM_BOT_TOKEN=
