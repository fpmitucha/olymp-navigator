# Скопируйте в .env и поменяйте значения. Файл .env не коммитится.

# Пароль базы для docker compose
POSTGRES_PASSWORD=поменяйте-меня

# Подключение к базе, если запускаете CLI без докера
DATABASE_URL=postgresql://olymp:поменяйте-меня@localhost:5432/olymp

# Как представляемся сайтам при обходе (укажите свой контакт)
USER_AGENT=OlympNavigatorBot/0.1 (+mailto:you@example.com)

# Пауза между запросами к одному сайту, секунды
REQUEST_DELAY=3

# Токен Telegram-бота от @BotFather. Никому не пересылайте его; если токен утёк — /revoke в @BotFather
TELEGRAM_BOT_TOKEN=

# Если бот получает сообщения, но ответы падают с «Request timeout» —
# сначала запустите: python -m app.cli bot check
# Только IPv4 (по умолчанию включено; 0 — разрешить IPv6)
# TELEGRAM_FORCE_IPV4=1
# Прокси для Telegram: http://логин:пароль@host:port или socks5://host:port (нужен pip install aiohttp-socks)
# TELEGRAM_PROXY=

# Раз в сутки обновлять даты этапов с olimpiada.ru, пока работает бот (0 — выключить)
# STAGES_AUTOSYNC=1

# Где бот хранит подписки и этапы (по умолчанию data/bot.sqlite3)
# BOT_DB_PATH=data/bot.sqlite3
